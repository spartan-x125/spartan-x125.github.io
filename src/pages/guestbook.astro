---
import "../styles/global.css";

import GiscusComments from "../components/GiscusComments.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import RightSidebar from "../components/RightSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { backgroundImages, mobileBackgroundImages } from "../data/backgroundImages";
import { getAllPosts } from "../utils/posts";

const posts = await getAllPosts();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="留言板" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name}</title>

  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)} data-backgrounds-mobile={JSON.stringify(mobileBackgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>
    <SiteHeader />
    <main class="blog-layout mobile-sidebar-collapsed">
      <ProfileSidebar mode="about" showContactLinks />
      <section class="feed" aria-labelledby="guestbook-title">
        <h1 id="guestbook-title">留言</h1>
        <GiscusComments title="留言区" term="guestbook" />
      </section>
      <RightSidebar posts={posts} />
    </main>
    <SiteFooter />
    <script is:inline src="/site.js?v=20261010-3"></script>
  </body>
</html>
