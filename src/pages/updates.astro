---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import RightSidebar from "../components/RightSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { backgroundImages } from "../data/backgroundImages";
import { getAllPosts, getPostUpdates } from "../utils/posts";

const posts = await getAllPosts();
const updates = getPostUpdates(posts);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="文章更新历史" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>更新历史 | {profile.name}</title>
    <ClientRouter />
  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>
    <SiteHeader />

    <main class="blog-layout mobile-sidebar-collapsed">
      <ProfileSidebar mode="about" showContactLinks />
      <section class="feed" aria-labelledby="updates-page-title">
        <p class="eyebrow">Changelog</p>
        <h1 id="updates-page-title">更新历史</h1>

        <div class="timeline-list">
          {
            updates.map((post) => (
              <article class="timeline-item">
                <time datetime={post.updatedDate}>{post.updatedDate}</time>
                <div>
                  <a href={`/posts/${post.slug}/`}>{post.title}</a>
                  <p>{post.description}</p>
                  <span>{post.category}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>
      <RightSidebar posts={posts} />
    </main>
    <SiteFooter />
    <script is:inline src="/site.js?v=20260620-3"></script>
  </body>
</html>
