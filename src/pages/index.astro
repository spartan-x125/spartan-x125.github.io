---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import RightSidebar from "../components/RightSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { backgroundImages } from "../data/backgroundImages";
import { getAllPosts, getPostUpdates } from "../utils/posts";

const allPosts = await getAllPosts();
const posts = allPosts.slice(0, 10);
const updates = getPostUpdates(allPosts).slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={profile.bio} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name}</title>
    <ClientRouter />
  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>

    <SiteHeader />

    <main class="blog-layout">
      <ProfileSidebar mode="home" />

      <section class="feed" aria-labelledby="feed-title">
        <div class="feed-header">
          <div>
            <p class="eyebrow">Latest Notes</p>
            <h2 id="feed-title">最新文章</h2>
          </div>
        </div>

        <div class="post-list">
          {
            posts.map((post) => (
              <article class="post-card">
                <a class="post-link" href={`/posts/${post.slug}/`}>
                  <div class="post-meta">
                    <time datetime={post.date}>{post.date}</time>
                    <span>{post.category}</span>
                  </div>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                </a>
                <div class="tag-row post-card-tags" aria-label={`${post.title} 的标签`}>
                  {
                    post.tags.map((tag) => (
                      <a class="tag post-tag-link" href={`/posts/?tag=${encodeURIComponent(tag)}`}>
                        {tag}
                      </a>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
        <div class="section-actions">
          <a class="text-button" href="/posts/">全部文章</a>
        </div>

        <section class="updates-section" aria-labelledby="updates-title">
          <div class="section-title-row">
            <div>
              <p class="eyebrow">Changelog</p>
              <h2 id="updates-title">更新历史</h2>
            </div>
            <a class="text-button" href="/updates/">完整历史</a>
          </div>
          <div class="update-list">
            {
              updates.map((post) => (
                <a class="update-card" href={`/posts/${post.slug}/`}>
                  <time datetime={post.updatedDate}>{post.updatedDate}</time>
                  <strong>{post.title}</strong>
                  <span>{post.category}</span>
                </a>
              ))
            }
          </div>
        </section>
      </section>

      <RightSidebar posts={allPosts} />
    </main>
    <SiteFooter />

    <script is:inline src="/site.js?v=20260621-4"></script>
  </body>
</html>
