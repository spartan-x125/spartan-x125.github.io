---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { backgroundImages } from "../data/backgroundImages";
import { friendLinks } from "../data/friendLinks";
import { getAllPosts } from "../utils/posts";

const posts = (await getAllPosts()).slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={profile.bio} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name}</title>
    <ClientRouter />
  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>

    <SiteHeader />

    <main class="blog-layout">
      <ProfileSidebar mode="home" />

      <section class="feed" aria-labelledby="feed-title">
        <div class="feed-header">
          <div>
            <p class="eyebrow">Latest Notes</p>
            <h2 id="feed-title">最新文章</h2>
          </div>
        </div>

        <div class="post-list">
          {
            posts.map((post) => (
              <article class="post-card">
                <a class="post-link" href={`/posts/${post.slug}/`}>
                  <time datetime={post.date}>{post.date}</time>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                </a>
                <div class="tag-row post-card-tags" aria-label={`${post.title} 的标签`}>
                  {
                    post.tags.map((tag) => (
                      <a class="tag post-tag-link" href={`/posts/?tag=${encodeURIComponent(tag)}`}>
                        {tag}
                      </a>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
        <div class="section-actions">
          <a class="text-button" href="/posts/">全部文章</a>
        </div>

        <section class="friends-section" aria-labelledby="friends-title">
          <p class="eyebrow">Friends</p>
          <h2 id="friends-title">友情站</h2>
          <div class="friend-list">
            {
              friendLinks.map((friend) => (
                <a class="friend-card" href={friend.url}>
                  <strong>{friend.name}</strong>
                  <span>{friend.description}</span>
                </a>
              ))
            }
          </div>
        </section>
      </section>
    </main>
    <SiteFooter />

    <script is:inline src="/site.js?v=20260601-1"></script>
  </body>
</html>
