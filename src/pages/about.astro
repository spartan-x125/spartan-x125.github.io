---
import "../styles/global.css";

import ProfileSidebar from "../components/ProfileSidebar.astro";
import RightSidebar from "../components/RightSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { backgroundImages } from "../data/backgroundImages";
import { getAllPosts } from "../utils/posts";

const posts = await getAllPosts();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={profile.bio} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name}</title>

  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>
    <SiteHeader />

    <main class="blog-layout about-layout">
      <ProfileSidebar mode="about" showContactLinks />
      <article class="article-page about-page">
        <a class="back-link" href="/">← 返回首页</a>
        <div class="about-hero">
          <img class="avatar about-avatar" src={profile.avatar} alt={`${profile.name} 的头像`} />
          <div>
            <h1>{profile.name}</h1>
          </div>
        </div>

        <div class="article-content">
          {profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
      <RightSidebar posts={posts} />
    </main>
    <SiteFooter />
    <script is:inline src="/site.js?v=20261009-9"></script>
  </body>
</html>
