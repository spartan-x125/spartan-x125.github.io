---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ProfileSidebar from "../../components/ProfileSidebar.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { profile, backgroundImages } from "../../data/profile";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../../content/posts/*.md");
  const posts = await Promise.all(
    Object.entries(postModules).map(async ([path, loader]) => {
      const post = await loader();
      const slug = path.split("/").pop()?.replace(".md", "");
      return { slug, post };
    }),
  );

  return posts
    .filter(({ post }) => !post.frontmatter.draft)
    .map(({ slug, post }) => ({
      params: { slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const Content = post.Content ?? post.default;
const title = `${post.frontmatter.title} | ${profile.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={post.frontmatter.description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>
    <header class="topbar">
      <a class="brand" href="/">{profile.title}</a>
      <nav class="topnav" aria-label="站点导航">
        <a href="/">首页</a>
        <button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗模式">◐</button>
      </nav>
    </header>
    <main class="blog-layout">
      <ProfileSidebar
        mode="article"
        title={post.frontmatter.title}
        description={post.frontmatter.description}
      />
      <article class="article-page">
        <a class="back-link" href="/">← 返回首页</a>
        <p class="post-date">{post.frontmatter.date}</p>
        <h1>{post.frontmatter.title}</h1>
        <p class="article-description">{post.frontmatter.description}</p>
        <div class="tag-row">
          {post.frontmatter.tags?.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="article-content">
          <Content />
        </div>
      </article>
    </main>
    <SiteFooter />
    <script is:inline src="/site.js"></script>
  </body>
</html>
