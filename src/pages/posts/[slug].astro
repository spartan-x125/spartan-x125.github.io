---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GiscusComments from "../../components/GiscusComments.astro";
import ProfileSidebar from "../../components/ProfileSidebar.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profile } from "../../data/profile";
import { backgroundImages } from "../../data/backgroundImages";
import { likeService } from "../../data/likeService";
import { getAllPosts } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { item, previous, next } = Astro.props;
const { post } = item;
const Content = post.Content ?? post.default;
const title = `${item.title} | ${profile.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={item.description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/avatar/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-backgrounds={JSON.stringify(backgroundImages)}>
    <div class="background-layer" aria-hidden="true" transition:persist></div>
    <SiteHeader />
    <main class="article-layout">
      <ProfileSidebar mode="article" />
      <article class="article-page">
        <a class="back-link" href="/posts/">← 返回文章列表</a>
        <p class="post-date">{item.date}</p>
        <h1>{item.title}</h1>
        <p class="article-description">{item.description}</p>
        <div class="tag-row article-tags" aria-label="文章标签">
          {
            item.tags?.map((tag) => (
              <a class="tag article-tag-link" href={`/posts/?tag=${encodeURIComponent(tag)}`}>
                {tag}
              </a>
            ))
          }
        </div>
        <div class="article-content">
          <Content />
        </div>

        <nav class="article-actions" aria-label="文章操作">
          <div class="article-action-left">
            {
              previous ? (
                <a class="back-link" href={`/posts/${previous.slug}/`}>← 上一篇文章</a>
              ) : (
                <span class="back-link is-disabled">← 上一篇文章</span>
              )
            }
          </div>
          <button
            class="like-button"
            type="button"
            data-like-key={`post-like-${item.slug}`}
            data-supabase-url={likeService.supabaseUrl}
            data-supabase-key={likeService.supabaseKey}
            aria-label="点赞文章"
          >
            <span aria-hidden="true">♥</span>
            <strong>0</strong>
          </button>
          <div class="article-action-right">
            {
              next ? (
                <a class="back-link" href={`/posts/${next.slug}/`}>下一篇文章 →</a>
              ) : (
                <span class="back-link is-disabled">下一篇文章 →</span>
              )
            }
          </div>
        </nav>

        <GiscusComments title="文章评论" term={`post-${item.slug}`} />
      </article>
      <aside class="article-reading-card" aria-labelledby="reading-title">
        <div class="article-reading-heading">
          <p class="eyebrow">Reading</p>
          <h2 id="reading-title">{item.title}</h2>
          <p>{item.description}</p>
        </div>
        <div class="reading-meter" aria-label="阅读进度">
          <span id="reading-progress-bar"></span>
        </div>
        <nav class="reading-toc" id="reading-toc" aria-label="文章目录"></nav>
      </aside>
    </main>
    <button
      class="floating-action-button article-floating-back-to-top back-to-top-button"
      id="back-to-top"
      type="button"
      aria-label="回到顶部"
      title="回到顶部"
    >
      <span aria-hidden="true">↑</span>
    </button>
    <SiteFooter />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="/site.js?v=20260615-5"></script>
  </body>
</html>
