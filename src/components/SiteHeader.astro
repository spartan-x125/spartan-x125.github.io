---
import { profile } from "../data/profile";
---

<header class="topbar">
  <a class="brand" href="/">{profile.title}</a>
  <nav class="topnav" aria-label="站点导航">
    <a href="/">首页</a>
    <a href="/posts/">文章</a>
    <a href="/friends/">友链</a>
    <a href="/guestbook/">留言</a>
    <button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗模式">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 14.2A7.7 7.7 0 0 1 9.8 3a8.5 8.5 0 1 0 11.2 11.2Z" />
      </svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
    </button>
  </nav>
</header>
