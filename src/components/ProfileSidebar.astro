---
import { profile } from "../data/profile";
import { musicTracks } from "../data/musicTracks";

const {
  mode = "home",
  title = "",
  description = "",
} = Astro.props;
---

<div class="sidebar-column">
  <aside class="profile-card" aria-label="侧边栏">
    <button
      class="sidebar-position-toggle"
      type="button"
      data-sidebar-position-toggle
      aria-label="切换侧边栏位置"
      title="切换侧边栏位置"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 5.5h16" />
        <path d="M4 18.5h16" />
        <path d="M7 8.5v7" />
        <path d="M12 9l-3.5 3 3.5 3" />
        <path d="M15 8.5h2.5a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5H15" />
      </svg>
    </button>

  <div class="profile-summary">
    <img class="avatar" src={profile.avatar} alt={`${profile.name} 的头像`} />
    <a class="profile-name" href="/about/">{profile.name}</a>
    <p class="signature">{profile.signature}</p>
    {mode === "home" && <p class="bio">{profile.bio}</p>}
  </div>

  {
    mode === "home" && (
      <div class="profile-links">
        <a class="app-link github-link" href={profile.github} aria-label="GitHub 主页">
          <span class="app-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img">
              <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5v-1.74c-2.78.62-3.37-1.38-3.37-1.38-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.36 9.36 0 0 1 12 6.94c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.92-2.34 4.78-4.57 5.04.36.32.68.95.68 1.92v2.85c0 .28.18.6.69.5A10.2 10.2 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
            </svg>
          </span>
          <span>GitHub</span>
        </a>
        <a class="app-link email-link" href={profile.email} aria-label="发送邮件">
          <span class="app-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img">
              <path d="M4.8 5h14.4A2.8 2.8 0 0 1 22 7.8v8.4a2.8 2.8 0 0 1-2.8 2.8H4.8A2.8 2.8 0 0 1 2 16.2V7.8A2.8 2.8 0 0 1 4.8 5Zm.1 2.1 6.52 5.18c.34.27.82.27 1.16 0L19.1 7.1H4.9Zm15 2.05-6.2 4.92a2.72 2.72 0 0 1-3.4 0L4.1 9.15v6.94c0 .45.35.81.78.81h14.24c.43 0 .78-.36.78-.81V9.15Z" />
            </svg>
          </span>
          <span>Email</span>
        </a>
      </div>
    )
  }

  {
    mode === "article" && (
      <section class="side-panel" aria-labelledby="reading-title">
        <p class="eyebrow">Reading</p>
        <h2 id="reading-title">{title}</h2>
        <p>{description}</p>
        <div class="reading-meter" aria-label="阅读进度">
          <span id="reading-progress-bar"></span>
        </div>
        <nav class="reading-toc" id="reading-toc" aria-label="文章目录"></nav>
      </section>
    )
  }

  {
    mode === "about" && (
      <section class="side-panel" aria-labelledby="about-side-title">
        <p class="eyebrow">Profile</p>
        <h2 id="about-side-title">{profile.about.heading}</h2>
        <p>{profile.about.paragraphs[0]}</p>
      </section>
    )
  }

  <section
    class="music-card"
    aria-labelledby="music-title"
    data-tracks={JSON.stringify(musicTracks)}
    transition:persist
  >
    <div class="music-heading">
      <p class="eyebrow">Now Playing</p>
    </div>
    <div class="music-player">
      <img class="music-cover" id="music-cover" src={musicTracks[0]?.cover} alt="" />
      <div class="music-info">
        <h2 id="music-title">{musicTracks[0]?.title}</h2>
        <p id="music-artist">{musicTracks[0]?.artist}</p>
        <div class="music-progress-row">
          <span id="music-current">0:00</span>
          <input
            class="music-progress"
            id="music-progress"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="播放进度"
          />
          <span id="music-duration">--:--</span>
        </div>
        <div class="music-controls">
          <button id="music-play" type="button" aria-label="播放或暂停">▶</button>
          <button id="music-prev" type="button" aria-label="上一首">‹</button>
          <button id="music-next" type="button" aria-label="下一首">›</button>
          <button id="music-mode" type="button" aria-label="切换播放模式">↻</button>
          <button id="music-list-toggle" type="button" aria-label="查看播放列表">☰</button>
        </div>
        <div class="music-volume-row">
          <span id="music-volume-icon" aria-hidden="true">♪</span>
          <input
            class="music-volume"
            id="music-volume"
            type="range"
            min="0"
            max="100"
            value="80"
            step="1"
            aria-label="播放音量"
          />
          <span id="music-volume-value">80%</span>
        </div>
      </div>
      <audio id="music-audio" preload="metadata" src={musicTracks[0]?.src}></audio>
      <div class="music-list" id="music-list" hidden>
        {musicTracks.map((track, index) => (
          <button type="button" data-track-index={index}>
            <span>{track.title}</span>
            <small>{track.artist}</small>
          </button>
        ))}
      </div>
    </div>
  </section>
  </aside>

  {
    mode === "article" && (
      <div class="sidebar-action-dock" aria-label="文章快捷操作">
        <button
          class="floating-action-button sidebar-back-to-top back-to-top-button"
          id="back-to-top"
          type="button"
          aria-label="回到顶部"
          title="回到顶部"
        >
          <span aria-hidden="true">↑</span>
        </button>
      </div>
    )
  }
</div>
