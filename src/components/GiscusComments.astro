---
const {
  term = "guestbook",
  title = "评论",
} = Astro.props;

const giscus = {
  repo: "spartan-x125/spartan-x125.github.io",
  repoId: "R_kgDOSeIVsA",
  category: "General",
  categoryId: "DIC_kwDOSeIVsM4C-Lls",
};
const isConfigured = Boolean(giscus.repoId && giscus.categoryId);
---

<section
  class="comments-section"
  aria-labelledby="comments-title"
  data-giscus-configured={String(isConfigured)}
  data-giscus-repo={giscus.repo}
  data-giscus-repo-id={giscus.repoId}
  data-giscus-category={giscus.category}
  data-giscus-category-id={giscus.categoryId}
  data-giscus-term={term}
>
  <div class="section-heading">
    <p class="eyebrow">Comments</p>
    <h2 id="comments-title">{title}</h2>
  </div>
  {
    isConfigured ? (
      <div class="giscus-host"></div>
    ) : (
      <div class="comment-note">
        <p>
          评论区尚未启用。请先在 GitHub 仓库开启 Discussions，再配置 Giscus。
        </p>
      </div>
    )
  }
</section>
